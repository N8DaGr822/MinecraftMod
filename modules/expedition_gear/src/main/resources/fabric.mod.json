	"authors": [
		"nathen.lentz"
	],
	"contact": {
		"sources": "https://github.com/N8DaGr822/MinecraftMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/darkspawn_expedition_gear/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"darkspawn.black.expeditiongear.ExpeditionGearMod"
		],
		"client": [
			"darkspawn.black.expeditiongear.client.ExpeditionGearClient"
		]
	},
	"mixins": [
		"darkspawn_expedition_gear.mixins.json"
	],
	"suggests": {
		"darkspawn_climate": "*"

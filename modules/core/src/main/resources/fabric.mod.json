{
	"schemaVersion": 1,
	"id": "darkspawn_core",
	"version": "${version}",
	"name": "Darkspawn Core",
	"description": "Shared library for Darkspawn mods: namespace, server tuning, payments, safe arrival, progression helpers and cross-mod hooks. Adds no gameplay content.",
	"authors": [
		"nathen.lentz"
	],
	"contact": {
		"sources": "https://github.com/N8DaGr822/MinecraftMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/darkspawn_core/icon.png",
	"environment": "*",
	"mixins": [
		"darkspawn_core.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"badges": [ "library" ]
		}
	}
}

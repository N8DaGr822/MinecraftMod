{
	"schemaVersion": 1,
	"id": "darkspawn_quiver",
	"version": "${version}",
	"name": "Darkspawn Quiver",
	"description": "Arrow quiver that feeds bows from its bundle-style storage.",
	"authors": [
		"nathen.lentz"
	],
	"contact": {
		"sources": "https://github.com/N8DaGr822/MinecraftMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/darkspawn_quiver/icon.png",

{
	"schemaVersion": 1,
	"id": "darkspawn_climate",
	"version": "${version}",
	"name": "Darkspawn Climate",
	"description": "Temperature exposure from biome, altitude, weather, shelter and wetness, with a HUD, hypothermia and heatstroke, and the Warmth and Cooling armor enchantments. Other mods add protection through the core climate hook.",
	"authors": [
		"nathen.lentz"
	],
	"contact": {
		"sources": "https://github.com/N8DaGr822/MinecraftMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/darkspawn_climate/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"darkspawn.black.climate.ClimateMod"
		],
		"client": [
			"darkspawn.black.climate.client.ClimateClient"
		]
	},
	"mixins": [
		"darkspawn_climate.mixins.json"
	],
	"suggests": {
		"darkspawn_expedition_gear": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"darkspawn_core": "*"
	}
}

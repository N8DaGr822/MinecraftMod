{
	"schemaVersion": 1,
	"id": "darkspawn",
	"version": "${version}",
	"name": "Darkspawn",
	"description": "Alpha: 16 post-dragon biome bosses, regional creatures, cooking, farming, inventory upgrades, and permanent boss-heart progression.",
	"authors": [
		"nathen.lentz"
	],
	"contact": {
		"sources": "https://github.com/N8DaGr822/MinecraftMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/darkspawn/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"darkspawn.black.Darkspawn"
		],
		"client": [
			"darkspawn.black.client.DarkspawnClient"
		],
		"fabric-datagen": [
			"darkspawn.black.client.DarkspawnDataGenerator"
		]
	},
	"mixins": [
		"darkspawn.mixins.json",
		{
			"config": "darkspawn.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": ">=5.5.7 <6"
	}
}
